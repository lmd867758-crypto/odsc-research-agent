# Copy this file to .env and fill in your own keys. Never commit .env.
# Get the keys (both have free tiers — see README.md):
#   Nebius Token Factory: https://dev.nebius.com/builders
#   Tavily: https://tavily.com (sign up, free tier)

NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional: change the model (must exist on Token Factory).
# Cheap default at time of writing: deepseek-ai/DeepSeek-V4-Flash.
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional: Token Factory base URL (regional fallback:
# https://api.tokenfactory.us-central1.nebius.com/v1)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional: server host/port
HOST=0.0.0.0
PORT=8000
